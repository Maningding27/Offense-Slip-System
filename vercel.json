{
  "version": 2,
  "rewrites": [
    {
      "source": "/image_proxy",
      "destination": "/api/image-proxy.js"
    },
    {
      "source": "/preview",
      "destination": "/api/preview.js"
    },
    {
      "source": "/responses",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
