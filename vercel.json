{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/image_proxy.php",
      "dest": "/image_proxy.php"
    },
    {
      "src": "/preview.php",
      "dest": "/preview.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ],
  "functions": {
    "*.php": {
      "runtime": "@vercel/php@0.6.0"
    }
  },
  "env": {
    "PHP_VERSION": "8.1"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
