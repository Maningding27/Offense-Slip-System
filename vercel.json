{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "@vercel/php@0.6.0"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.php"
    }
  ],
  "env": {
    "PHP_VERSION": "8.1"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
